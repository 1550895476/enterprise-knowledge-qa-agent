# Required OpenAI-compatible model configuration. Do not commit real values.
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
MODEL_PROTOCOL=chat_completions
MODEL_REASONING_EFFORT=none
MODEL_RESPONSE_FORMAT=json_object

# Optional retrieval backends. Empty values use local deterministic fallbacks.
MILVUS_URI=
MILVUS_TOKEN=
MONGODB_URI=
ENABLE_BGE=0
# Set to 1 on networks where Hugging Face Xet CDN is unstable.
HF_HUB_DISABLE_XET=1
# After the weights have been downloaded, these prevent startup from depending on Hugging Face connectivity.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
# Optional minimum cosine similarity for embedding-only basic KB hits.
# Empty uses 0.25 for hashing fallback and 0.55 for BGE-M3.
DENSE_MIN_SCORE=
# Optional relevance floor; empty uses 0 for lexical fallback and 0.1 for BGE reranking.
# Increase this if unrelated questions still retrieve weak evidence; validate against paraphrase recall.
RERANK_MIN_SCORE=
MAX_UPLOAD_BYTES=20971520
